# --- Providers (secrets only via environment; never commit .env) ---
MKA_LLM_PROVIDER=none            # none | openai | gemini
MKA_EMBEDDING_PROVIDER=hash      # hash (offline, lexical-ish) | openai | gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
# MKA_OPENAI_CHAT_MODEL=gpt-4o-mini
# MKA_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# MKA_GEMINI_CHAT_MODEL=gemini-2.0-flash
# MKA_GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Storage ---
MKA_VECTOR_STORE=local           # local | chroma
MKA_DATA_DIR=./data

# --- Limits / security ---
MKA_MAX_UPLOAD_MB=50
MKA_ALLOW_PRIVATE_URLS=false     # keep false in production (SSRF protection)
MKA_OCR_ENABLED=false            # needs pytesseract + tesseract binary
