# ============================================================================
# Multi-Agent Knowledge Assistant - configuration (all variables use the MKA_ prefix
# except the two provider API keys). Never commit a real .env file.
# ============================================================================

# ---- environment ------------------------------------------------------------
MKA_ENV=dev                        # dev | production (production refuses insecure settings at startup)
MKA_DATA_DIR=./data                # documents, chunks, vectors (local store), uploads. Must be shared by API + worker.

# ---- database / cache / queue -------------------------------------------------
# PostgreSQL in production; leave empty for SQLite in MKA_DATA_DIR (dev only)
MKA_DATABASE_URL=postgresql+psycopg2://mka:change-me@localhost:5432/mka
MKA_REDIS_URL=redis://localhost:6379/0   # shared rate limiting + job queue
MKA_JOB_BACKEND=inprocess          # inprocess | redis  (redis => run `python -m app.worker` separately)
MKA_JOB_WORKERS=2
MKA_JOB_MAX_ATTEMPTS=3

# ---- authentication / multi-tenancy ---------------------------------------------
MKA_AUTH_ENABLED=false             # MUST be true in production
MKA_ALLOW_SIGNUP=true              # MUST be false in production (create tenants with: python -m app.cli create-tenant)
MKA_JWT_SECRET=                    # >= 32 random chars:  python -c "import secrets; print(secrets.token_urlsafe(48))"
MKA_ACCESS_TOKEN_MINUTES=60
MKA_CORS_ORIGINS=                  # comma separated; empty = same origin only

# ---- rate limits (N/second|minute|hour) ---------------------------------------
MKA_RATE_LIMIT_ENABLED=true
MKA_RATE_LIMIT_ASK=30/minute
MKA_RATE_LIMIT_INGEST=20/minute
MKA_RATE_LIMIT_AUTH=10/minute

# ---- model providers (keys come ONLY from the environment) ----------------------
MKA_LLM_PROVIDER=none              # none | openai | gemini     (none => extractive answers, no generation)
MKA_EMBEDDING_PROVIDER=hash        # hash (offline, lexical) | openai | gemini   <- use a real embedder for semantic recall
OPENAI_API_KEY=
GEMINI_API_KEY=
MKA_OPENAI_CHAT_MODEL=gpt-4o-mini
MKA_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MKA_GEMINI_CHAT_MODEL=gemini-2.0-flash
MKA_GEMINI_EMBEDDING_MODEL=text-embedding-004
MKA_PRICE_TABLE=gpt-4o-mini=0.15:0.60,gemini-2.0-flash=0.10:0.40,text-embedding-3-small=0.02:0   # USD per 1M tokens in:out

# ---- vector store -----------------------------------------------------------------
MKA_VECTOR_STORE=local             # local | chroma (dev) | qdrant (production)
MKA_QDRANT_URL=http://localhost:6333
MKA_QDRANT_API_KEY=
# MKA_QDRANT_PATH=./data/qdrant    # embedded single-process mode (dev/tests) when no URL is set

# ---- retrieval defaults (each can be overridden per request) --------------------------
MKA_RETRIEVAL_MODE=hybrid          # semantic | keyword | hybrid
MKA_TOP_K=6
MKA_QUERY_REWRITE=true
MKA_MULTI_QUERY=false
MKA_HYDE=false
MKA_PARENT_CHILD=true
MKA_COMPRESSION=true
MKA_RERANKER=lexical               # none | lexical | llm | cross_encoder
MKA_CORRECTIVE=true
MKA_MAX_RETRIES=2                  # bound for corrective-RAG and verification retries
MKA_GRAPH_RAG=false
MKA_CROSS_LINGUAL=true

# ---- agents ---------------------------------------------------------------------------
MKA_SUPERVISOR_MODE=rules          # rules | llm
MKA_CHECKPOINT_BACKEND=memory      # memory | sqlite | postgres
MKA_MEMORY_TURNS=10
MKA_WEB_ENABLED=true               # Web Agent may fetch URLs found in a question (SSRF-guarded)
MKA_WEB_SEARCH_PROVIDER=none       # none | searxng | brave
MKA_WEB_SEARCH_URL=
BRAVE_API_KEY=
MKA_WEB_FALLBACK=false

# ---- ingestion / security -----------------------------------------------------------------
MKA_MAX_UPLOAD_MB=50
MKA_MAX_PDF_PAGES=5000
MKA_OCR_ENABLED=false              # OCR for scanned PDFs (needs the Tesseract binary)
MKA_OCR_LANGUAGES=eng              # e.g. eng+hin
MKA_VISION_CAPTIONS=false          # caption image files with a vision-capable LLM
MKA_ALLOW_PRIVATE_URLS=false       # MUST stay false in production (SSRF protection)
MKA_INJECTION_POLICY=flag          # flag | exclude (exclude => suspected injections never reach the LLM)
MKA_AUDIT_ENABLED=true
